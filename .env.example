# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Куда присылать заявки и откуда смотреть /stats (id чата или группы; узнать — написать боту /id)
ADMIN_CHAT_ID=
# Необязательно: адрес конфигуратора сметы, появится кнопкой под результатом. Можно без https://, но http не подойдёт
CONFIGURATOR_URL=
# Папка для данных. На Railway подключите Volume и укажите его путь, например /data. По умолчанию ./data
DATA_DIR=
